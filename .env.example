VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id


# Optional: Home hero background — 11-character YouTube video ID (from the watch URL).
# If unset, a default scenic B-roll is used. Set in CI env if you want a different video in production builds.
# VITE_HERO_YOUTUBE_VIDEO_ID=

# Optional: second Web app (dev). Used for `npm run dev` and `npm run build:dev` (Vite mode `staging`).
VITE_FIREBASE_APP_ID_DEV=
VITE_FIREBASE_MEASUREMENT_ID_DEV=

# Multi-site Hosting: `npm run deploy:release` deploys the dev-web-app build to the `release` target (see `.firebaserc`).
# Create the site first (Hosting → Add another site, or `firebase hosting:sites:create eucc-online-release`), or change
# `targets.eucc-online.hosting.release` in `.firebaserc` to your real site ID.
