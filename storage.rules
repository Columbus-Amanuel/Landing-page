rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function callerRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return request.auth != null && (callerRole() == 'admin' || callerRole() == 'super-admin');
    }

    match /sermons/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /profiles/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || isStaff());
    }
  }
}
